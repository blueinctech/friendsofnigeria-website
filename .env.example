# Copy to .env for local development. Never commit .env.
# On Vercel, set these under Project → Settings → Environment Variables.
# On a Node host (Hostinger), also set CMS_ADAPTER=node and CMS_ALLOWED_HOSTS=<your domains>.
# See docs/admin-cms.md for what each one does.

# Required: Postgres connection string (Neon adds this automatically on Vercel)
DATABASE_URL=

# First administrator: secret (16+ characters) for /admin/setup/. Remove after setup.
ADMIN_SETUP_TOKEN=

# Optional: store uploaded images in an S3 bucket (AWS, R2, ...) instead of the database.
# The bucket can stay private; the site serves files from /media/<key>.
S3_BUCKET=
S3_REGION=
# S3_ENDPOINT=   only for non-AWS S3-compatible storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: store uploaded images in Vercel Blob instead (ignored when S3_BUCKET is set)
BLOB_READ_WRITE_TOKEN=

# Optional: email notifications and password links. Amazon SES is used when set, else Resend.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=
RESEND_API_KEY=
FORM_FROM_EMAIL=
FORM_TO_EMAIL=

# Optional: add newsletter sign-ups to a Brevo list
BREVO_API_KEY=
BREVO_LIST_ID=

# Optional tuning (defaults shown)
# ADMIN_SESSION_IDLE_MINUTES=120
# ADMIN_SESSION_MAX_HOURS=12
# PUBLIC_CACHE_SECONDS=30
# MEDIA_MAX_UPLOAD_MB=4
# DATABASE_POOL_MAX=3
