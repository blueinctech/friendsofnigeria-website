# Copy to .env for local development. Never commit .env.
# On Vercel, set these under Project → Settings → Environment Variables.
# See docs/admin-cms.md for what each one does.

# Required: Postgres connection string (Neon adds this automatically on Vercel)
DATABASE_URL=

# First administrator: secret (16+ characters) for /admin/setup/. Remove after setup.
ADMIN_SETUP_TOKEN=

# Optional: store uploaded images in Vercel Blob instead of the database
BLOB_READ_WRITE_TOKEN=

# Optional: email notifications and password links (Resend)
RESEND_API_KEY=
FORM_FROM_EMAIL=
FORM_TO_EMAIL=

# Optional: add newsletter sign-ups to a Brevo list
BREVO_API_KEY=
BREVO_LIST_ID=

# Optional tuning (defaults shown)
# ADMIN_SESSION_IDLE_MINUTES=120
# ADMIN_SESSION_MAX_HOURS=12
# PUBLIC_CACHE_SECONDS=30
# MEDIA_MAX_UPLOAD_MB=4
# DATABASE_POOL_MAX=3
