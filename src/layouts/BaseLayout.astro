---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSite, ogImageUrl, telHref, type Media } from '../lib/server/public';

interface Props {
  title: string;
  /** Complete <title>, used as is (otherwise the SEO suffix is added). */
  fullTitle?: string;
  description?: string | null;
  image?: Media | null;
  imageAlt?: string | null;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
  canonical?: string | null;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { site, seo, media } = await getSite(Astro.locals);
const {
  title,
  fullTitle: givenTitle,
  description: rawDescription,
  image,
  imageAlt,
  type = 'website',
  publishedTime,
  noindex = false,
  canonical: canonicalOverride,
  jsonLd,
} = Astro.props;

// Search results show about 160 characters: cut longer descriptions at a word.
const clean = (rawDescription || seo.default_description || site.description || '').replace(/\s+/g, ' ').trim();
const description = clean.length <= 160 ? clean : `${clean.slice(0, 157).replace(/[\s,;:.–—-]+\S*$/, '')}…`;

const fullTitle = givenTitle || `${title}${seo.title_suffix ?? ''}`;
const origin = Astro.site ?? Astro.url;
const canonical = canonicalOverride || new URL(Astro.url.pathname, origin).toString();
const ogMedia = image ?? media[seo.default_og_image] ?? null;
const ogPath = ogImageUrl(ogMedia);
const ogUrl = ogPath ? new URL(ogPath, origin).toString() : null;
const hideFromSearch = noindex || seo.indexing === false || Astro.locals.preview;

const org = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: site.name,
  alternateName: site.short_name || undefined,
  url: new URL('/', origin).toString(),
  logo: new URL('/icon-512.png', origin).toString(),
  description: site.description,
  email: site.email,
  telephone: (site.phones ?? []).map((p: { display: string }) => telHref(p.display).slice(4)),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address,
    postalCode: site.postcode,
    addressLocality: site.city,
    addressCountry: site.country,
  },
  sameAs: (site.social ?? []).map((s: { url: string }) => s.url),
};
const ld = [org, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hideFromSearch && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogMedia?.og_url && <meta property="og:image:width" content="1200" />}
    {ogMedia?.og_url && <meta property="og:image:height" content="630" />}
    {ogUrl && <meta property="og:image:alt" content={imageAlt || ogMedia?.alt || seo.default_og_alt || ''} />}
    <meta property="og:locale" content="en_GB" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    {seo.twitter_handle && <meta name="twitter:site" content={seo.twitter_handle} />}
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogUrl && <meta name="twitter:image" content={ogUrl} />}

    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <slot name="head" />
  </head>
  <body>
    {
      Astro.locals.preview && (
        <div class="preview-bar" role="status">
          Preview: drafts and scheduled content are visible. <a href={Astro.url.pathname}>Leave preview</a>
        </div>
      )
    }
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/motion.ts';
      import '../scripts/forms.ts';
    </script>
  </body>
</html>

<style is:global>
  .preview-bar {
    position: fixed;
    inset: auto 12px 12px auto;
    z-index: 1000;
    background: #1b1b1b;
    color: #fff;
    font-size: 13px;
    padding: 10px 14px;
    border-radius: 10px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.25);
  }
  .preview-bar a {
    color: #8fe0b0;
    margin-left: 6px;
  }
</style>
