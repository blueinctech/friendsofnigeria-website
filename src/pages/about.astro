---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import TeamCard from '../components/TeamCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { getPage, getSite, homeTeam, img, listTeam, pageSeo } from '../lib/server/public';

const preview = Astro.locals.preview;
const page = await getPage('about', preview);
if (!page) return Astro.rewrite('/404/');
const c = page.content;
const { site } = await getSite(Astro.locals);
const groups = await listTeam(preview);
// The executive board is the first board on the team page.
const board = groups[0]?.people ?? (await homeTeam(preview));
const visionImg = img(page.media[c.vision_image], { alt: c.vision_image_alt, sizes: '(min-width: 900px) 560px, 100vw' });
const missionImg = img(page.media[c.mission_image], { alt: c.mission_image_alt, sizes: '(min-width: 900px) 560px, 100vw', style: 'object-position:center 80%' });
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<BaseLayout {...pageSeo(page)}>
  <PageHero title={page.title} lead={page.lead} crumbs={[{ label: 'About us' }]} image={page.hero} imageAlt={page.hero_alt} imagePosition="center 40%">
    <div class="btn-row">
      {c.primary_cta_label && <a href={c.primary_cta_url} class="btn">{c.primary_cta_label} <Icon name="arrow-right" size={16} class="arrow" /></a>}
      {c.secondary_cta_label && <a href={c.secondary_cta_url} class="btn btn--ghost">{c.secondary_cta_label}</a>}
    </div>
  </PageHero>

  <section class="section">
    <div class="container vm">
      <article class="vm-item" data-reveal>
        <div class="media vm-media" data-parallax>
          {visionImg && <img {...visionImg} />}
        </div>
        <div class="vm-copy">
          <h2>{c.vision_heading}</h2>
          <p class="lead">{c.vision}</p>
        </div>
      </article>
      <article class="vm-item vm-item--flip" data-reveal>
        <div class="media vm-media" data-parallax>
          {missionImg && <img {...missionImg} />}
        </div>
        <div class="vm-copy">
          <h2>{c.mission_heading}</h2>
          {c.mission_sub && <p class="vm-sub">{c.mission_sub}</p>}
          <ol class="mission-list" role="list">
            {
              (c.mission ?? []).map((m: { title: string; text: string }, i: number) => (
                <li>
                  <span class="m-num">{num(i)}</span>
                  <div>
                    <h3>{m.title}</h3>
                    <p>{m.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </article>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container">
      <div class="section-head">
        <h2 data-reveal>{c.values_heading}</h2>
        {c.values_lead && <p data-reveal style="--reveal-delay:80">{c.values_lead}</p>}
      </div>
      <ul class="values" role="list">
        {
          (c.values ?? []).map((v: { title: string; text: string }, i: number) => (
            <li class="spotlight" data-reveal style={`--reveal-delay:${i * 70}`}>
              <span class="v-num">{num(i)}</span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 data-reveal>{c.chapters_heading}</h2>
        {c.chapters_lead && <p data-reveal style="--reveal-delay:80">{c.chapters_lead}</p>}
      </div>
      <ul class="chapters-grid" role="list">
        {
          (c.chapters ?? []).map((ch: { name: string; text: string }, i: number) => (
            <li data-reveal style={`--reveal-delay:${i * 70}`}>
              <Icon name="map-pin" size={20} />
              <h3>{ch.name}</h3>
              <p>{ch.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="hq">
        <strong>Head office:</strong> {site.address}, {[site.postcode, site.city].filter(Boolean).join(' ')}, {site.country}
      </p>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <h2 data-reveal>{c.board_heading}</h2>
          {c.board_lead && <p data-reveal>{c.board_lead}</p>}
        </div>
        {c.board_link_label && <a href="/team/" class="link-arrow">{c.board_link_label} <Icon name="arrow-right" /></a>}
      </div>
      <ul class="team-grid" role="list">
        {
          board.map((p, i) => (
            <li data-reveal style={`--reveal-delay:${i * 70}`}>
              <TeamCard person={p} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .vm {
    display: grid;
    gap: clamp(4rem, 3rem + 4vw, 7rem);
  }
  .vm-item {
    display: grid;
    gap: var(--s-6);
    align-items: center;
  }
  @media (min-width: 900px) {
    .vm-item {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-9);
    }
    .vm-item--flip .vm-media {
      order: 2;
    }
  }
  .vm-media {
    aspect-ratio: 4 / 3;
  }
  .vm-copy {
    display: grid;
    gap: var(--s-4);
  }
  .vm-sub {
    color: var(--ink-3);
  }
  .mission-list {
    list-style: none;
    padding: 0;
    display: grid;
    margin-top: var(--s-3);
    border-top: 1px solid var(--line);
  }
  .mission-list li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: var(--s-3);
    padding: var(--s-5) 0;
    border-bottom: 1px solid var(--line);
  }
  .m-num,
  .v-num {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--accent-ink);
    font-variant-numeric: tabular-nums;
    padding-top: 4px;
  }
  .mission-list h3 {
    font-size: var(--fs-h4);
  }
  .mission-list p {
    margin-top: var(--s-2);
    color: var(--ink-2);
  }
  .values {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  @media (min-width: 700px) {
    .values {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1100px) {
    .values {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .values li {
    background: var(--white);
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .values h3 {
    font-size: var(--fs-h3);
    margin-top: var(--s-4);
  }
  .values p {
    color: var(--ink-2);
    font-size: var(--fs-sm);
    line-height: 1.65;
  }
  .chapters-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-6);
  }
  @media (min-width: 700px) {
    .chapters-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1100px) {
    .chapters-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .chapters-grid li {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding-top: var(--s-5);
    border-top: 2px solid var(--ink);
  }
  .chapters-grid :global(svg) {
    color: var(--accent);
  }
  .chapters-grid h3 {
    font-size: var(--fs-h4);
  }
  .chapters-grid p {
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }
  .hq {
    margin-top: var(--s-7);
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }
  .hq strong {
    color: var(--ink);
  }
  .team-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-5);
  }
  @media (min-width: 800px) {
    .team-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .team-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
