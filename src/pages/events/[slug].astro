---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { formatDate } from '../../lib/format';
import { getEvent, getSite, img, listAlbums, listEvents } from '../../lib/server/public';

const preview = Astro.locals.preview;
const d = await getEvent(Astro.params.slug ?? '', preview);
if (!d) return Astro.rewrite('/404/');
const { site } = await getSite(Astro.locals);
const name = d.short_title || d.title;
const albums = d.kind === 'flagship' ? (await listAlbums(preview)).filter((a) => a.type === 'Flagship event' && a.title.toLowerCase().includes(name.toLowerCase())) : [];
const others = (await listEvents(preview)).filter((e) => e.id !== d.id && e.kind === d.kind);
const other = others[0];
const place = [d.venue, [d.address, d.city].filter(Boolean).join(' ')].filter(Boolean);
const dates = d.start ? (d.end && d.end.valueOf() !== d.start.valueOf() ? `${formatDate(d.start)} – ${formatDate(d.end)}` : formatDate(d.start)) : null;
const ld = {
  '@context': 'https://schema.org',
  '@type': d.kind === 'flagship' ? 'EventSeries' : 'Event',
  name: d.title,
  description: d.summary,
  url: d.website_url ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString(),
  startDate: d.kind === 'flagship' ? undefined : d.start?.toISOString().slice(0, 10),
  location: { '@type': 'Place', name: d.venue ?? d.city ?? 'Paris', address: [d.address, d.city].filter(Boolean).join(' ') || 'Paris, France' },
  organizer: { '@type': 'Organization', name: site.name, url: new URL('/', Astro.site ?? Astro.url).toString() },
};
const heroImg = img(d.image, { alt: d.image_alt, sizes: '(min-width: 1000px) 620px, 100vw', loading: 'eager', fetchpriority: 'high' });
---

<BaseLayout title={d.seo_title || d.title} description={d.seo_description || d.summary} image={d.og ?? d.image} imageAlt={d.image_alt} canonical={d.canonical_url} jsonLd={ld}>
  <section class="ev-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Events', href: '/events/' }, { label: name }]} tone="dark" />
      <div class="ev-hero-grid">
        <div class="ev-hero-copy">
          {(d.since || d.city) && <p class="ev-since">{[d.since && `Since ${d.since}`, d.city].filter(Boolean).join(' · ')}</p>}
          {!d.since && dates && <p class="ev-since">{dates}</p>}
          <h1>{d.title}</h1>
          {d.tagline && <p class="ev-lead">{d.tagline}</p>}
          <div class="btn-row">
            {d.upcoming && d.registration_url && (
              <a href={d.registration_url} class="btn btn--light" target="_blank" rel="noopener">
                Register <Icon name="arrow-up-right" size={16} />
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            )}
            {d.website_url && (
              <a href={d.website_url} class:list={['btn', d.upcoming && d.registration_url ? 'btn--ghost-light' : 'btn--light']} target="_blank" rel="noopener">
                Visit the official website <Icon name="arrow-up-right" size={16} />
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            )}
            <a href={`/contact/?topic=${encodeURIComponent(name === 'NIDA' ? 'NIDA' : name === 'Spotlight Nigeria' ? 'Spotlight Nigeria' : 'Other')}`} class="btn btn--ghost-light">
              Enquire
            </a>
          </div>
        </div>
        <div class="media ev-hero-media">
          {heroImg && <img {...heroImg} />}
        </div>
      </div>
    </div>
  </section>

  {
    d.stats.length > 0 && (
      <section class="ev-stats">
        <div class="container">
          <dl class="stats-row">
            {d.stats.map((s) => (
              <div>
                <dt class="visually-hidden">{s.label}</dt>
                <dd>
                  <span class="sv">
                    <span data-count={s.value < 1000 ? s.value : undefined}>{s.value}</span>
                    {s.suffix}
                  </span>
                  <span class="sl" aria-hidden="true">{s.label}</span>
                </dd>
              </div>
            ))}
          </dl>
          {d.stats_source && <p class="source">Source: {d.stats_source}</p>}
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container ev-body">
      <div class="prose" data-reveal>
        <h2>About {name}</h2>
        <Fragment set:html={d.body} />
      </div>
      <aside class="ev-aside" data-reveal style="--reveal-delay:100">
        {
          (dates || place.length > 0) && (
            <div class="edition">
              <h2 class="aside-title">{d.kind === 'flagship' && !d.upcoming ? 'Latest edition' : d.upcoming ? 'Next edition' : 'Event details'}</h2>
              {d.edition_name && <p class="edition-name">{d.edition_name}</p>}
              <ul role="list">
                {dates && (
                  <li>
                    <Icon name="calendar" size={16} />
                    {dates}
                  </li>
                )}
                {place.length > 0 && (
                  <li>
                    <Icon name="map-pin" size={16} />
                    <span>
                      {place[0]}
                      {place[1] && <br />}
                      {place[1]}
                    </span>
                  </li>
                )}
              </ul>
            </div>
          )
        }
        {d.highlights.length > 0 && (
          <div class="highlights">
            <h2 class="aside-title">Who it brings together</h2>
            <ul role="list">
              {d.highlights.map((h) => (
                <li>
                  <Icon name="check" size={16} />
                  {h}
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>

  {
    d.gallery.length > 0 && (
      <section class="section section--tight">
        <div class="container">
          <ul class="ev-gallery" role="list">
            {d.gallery.map((g, i) => (
              <li class="media" data-reveal="image" style={`--reveal-delay:${i * 80}`}>
                <img {...img(g, { alt: g.alt || `${name}${d.city ? ` in ${d.city}` : ''}`, sizes: '(min-width: 900px) 25vw, 50vw', maxWidth: 800 })} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    albums.length > 0 && (
      <section class="section section--subtle">
        <div class="container">
          <div class="section-head section-head--split">
            <h2>Previous editions in pictures</h2>
            <a href="/gallery/" class="link-arrow">
              Photo gallery <Icon name="arrow-right" />
            </a>
          </div>
          <ul class="albums" role="list">
            {albums.map((a) => (
              <li>
                <AlbumCard album={a} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    other && (
      <section class="section section--tight">
        <div class="container">
          <a href={`/events/${other.slug}/`} class="other">
            <span class="other-k">{d.kind === 'flagship' ? 'Our other flagship event' : 'Another event'}</span>
            <span class="other-t">
              {other.title} <Icon name="arrow-right" size={24} />
            </span>
          </a>
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>

<style>
  .ev-hero {
    background: var(--slate-900);
    color: var(--grey-200);
    padding: clamp(2rem, 1.5rem + 2vw, 3.5rem) 0 clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }
  .ev-hero-grid {
    display: grid;
    gap: var(--s-7);
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    align-items: center;
  }
  @media (min-width: 1000px) {
    .ev-hero-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-9);
    }
  }
  .ev-hero-copy {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .ev-since {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--green-500);
  }
  .ev-hero h1 {
    color: var(--white);
    font-size: clamp(2.25rem, 1.5rem + 2.8vw, 3.75rem);
  }
  .ev-lead {
    font-size: var(--fs-xl);
    color: var(--grey-300);
    max-width: 40ch;
  }
  .ev-hero-media {
    aspect-ratio: 16 / 10;
    background: var(--slate-800);
  }
  .ev-hero-media img {
    object-position: left center;
  }
  .ev-stats {
    border-bottom: 1px solid var(--line);
  }
  .stats-row {
    display: grid;
    gap: 0;
  }
  @media (min-width: 760px) {
    .stats-row {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    }
  }
  .stats-row > div {
    padding: var(--s-6) var(--s-5) var(--s-6) 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 760px) {
    .stats-row > div {
      border-bottom: 0;
    }
    .stats-row > div + div {
      padding-left: var(--s-5);
      border-left: 1px solid var(--line);
    }
  }
  .sv {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.8rem + 1.8vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .sl {
    display: block;
    margin-top: var(--s-3);
    font-size: var(--fs-sm);
    color: var(--ink-3);
    max-width: 32ch;
  }
  .source {
    font-size: var(--fs-xs);
    color: var(--ink-3);
    padding-bottom: var(--s-4);
  }
  .ev-body {
    display: grid;
    gap: var(--s-8);
  }
  @media (min-width: 1000px) {
    .ev-body {
      grid-template-columns: minmax(0, 1fr) 380px;
      gap: var(--s-9);
      align-items: start;
    }
  }
  .ev-body .prose h2 {
    margin-top: 0;
    font-size: var(--fs-h2);
  }
  .ev-aside {
    display: grid;
    gap: var(--s-6);
  }
  .aside-title {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: var(--s-3);
  }
  .edition {
    padding: var(--s-6);
    background: var(--paper);
    border-radius: var(--r-sm);
  }
  .edition-name {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    font-weight: 600;
    letter-spacing: -0.015em;
    margin-bottom: var(--s-4);
  }
  .edition ul,
  .highlights ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 12px;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .edition li,
  .highlights li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .edition :global(svg),
  .highlights :global(svg) {
    flex: none;
    margin-top: 4px;
    color: var(--accent);
  }
  .ev-gallery {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  @media (min-width: 900px) {
    .ev-gallery {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .ev-gallery li {
    aspect-ratio: 1;
  }
  .albums {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-6) var(--s-5);
  }
  @media (min-width: 700px) {
    .albums {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .albums {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .other {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-7) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .other-k {
    font-size: var(--fs-sm);
    color: var(--ink-3);
  }
  .other-t {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .other-t :global(svg) {
    flex: none;
    transition: transform 240ms var(--ease);
  }
  .other:hover .other-t {
    color: var(--accent-ink);
  }
  .other:hover .other-t :global(svg) {
    transform: translateX(6px);
  }
</style>
