---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import TeamCard from '../../components/TeamCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { groupLabels, groupOrder } from '../../lib/format';
import heroImg from '../../assets/about/team-group.png';

const people = await getCollection('team');
const groups = groupOrder
  .map((g) => ({ id: g, ...groupLabels[g], people: people.filter((p) => p.data.group === g).sort((a, b) => a.data.order - b.data.order) }))
  .filter((g) => g.people.length);
---

<BaseLayout
  title="Management team"
  description="Meet the honorary board, executive board and country chapter leads of Friends of Nigeria across France, Germany, Belgium, Luxembourg and Nigeria."
  image={heroImg}
>
  <PageHero
    title="The people behind Friends of Nigeria"
    lead="Our boards and chapter leads are professionals at the forefront of their careers, volunteering their time to connect Nigeria and Europe."
    crumbs={[{ label: 'About us', href: '/about/' }, { label: 'Management team' }]}
  >
    <nav aria-label="Jump to a board" class="jump">
      <ul role="list">
        {groups.map((g) => <li><a href={`#${g.id}`}>{g.title.replace(', FON Europe', '').replace(' Executive Board', '').replace(' Sub-committee Leads', ' committees')}</a></li>)}
      </ul>
    </nav>
  </PageHero>

  {
    groups.map((g, gi) => (
      <section class:list={['section', 'section--tight', { 'section--subtle': gi % 2 === 1 }]} id={g.id}>
        <div class="container">
          <div class="group-head">
            <h2 data-reveal>{g.title}</h2>
            <p data-reveal style="--reveal-delay:60">{g.description}</p>
          </div>
          <ul class="team-grid" role="list">
            {g.people.map((p, i) => (
              <li data-reveal style={`--reveal-delay:${(i % 5) * 60}`}>
                <TeamCard person={p} eager={gi === 0} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <CtaBand title="Want to contribute to the network?" text="Friends of Nigeria is run by volunteers across Europe and Nigeria. Join as a member, or get in touch to find out how you can help." />
</BaseLayout>

<style>
  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: var(--fs-xs);
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-2);
    transition:
      border-color 160ms var(--ease),
      color 160ms var(--ease);
  }
  .jump a:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .group-head {
    display: grid;
    gap: var(--s-3);
    margin-bottom: var(--s-7);
    max-width: 70ch;
  }
  .group-head h2 {
    font-size: clamp(1.625rem, 1.3rem + 1.2vw, 2.25rem);
  }
  .group-head p {
    color: var(--ink-2);
  }
  .team-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-7) var(--s-5);
  }
  @media (min-width: 800px) {
    .team-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .team-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
