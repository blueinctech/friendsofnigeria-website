---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import TeamCard from '../../components/TeamCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getPage, listTeam, pageSeo } from '../../lib/server/public';

const preview = Astro.locals.preview;
const page = await getPage('team', preview);
if (!page) return Astro.rewrite('/404/');
const groups = await listTeam(preview);
---

<BaseLayout {...pageSeo(page)}>
  <PageHero title={page.title} lead={page.lead} crumbs={[{ label: 'About us', href: '/about/' }, { label: 'Management team' }]}>
    <nav aria-label="Jump to a board" class="jump">
      <ul role="list">
        {groups.map((g) => <li><a href={`#${g.slug}`}>{g.nav_label || g.title}</a></li>)}
      </ul>
    </nav>
  </PageHero>

  {
    groups.map((g, gi) => (
      <section class:list={['section', 'section--tight', { 'section--subtle': gi % 2 === 1 }]} id={g.slug}>
        <div class="container">
          <div class="group-head">
            <h2 data-reveal>{g.title}</h2>
            {g.description && <p data-reveal style="--reveal-delay:60">{g.description}</p>}
          </div>
          <ul class="team-grid" role="list">
            {g.people.map((p, i) => (
              <li data-reveal style={`--reveal-delay:${(i % 5) * 60}`}>
                <TeamCard person={p} eager={gi === 0} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <CtaBand title={page.content.cta_title} text={page.content.cta_text} />
</BaseLayout>

<style>
  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: var(--fs-xs);
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-2);
    transition:
      border-color 160ms var(--ease),
      color 160ms var(--ease);
  }
  .jump a:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .group-head {
    display: grid;
    gap: var(--s-3);
    margin-bottom: var(--s-7);
    max-width: 70ch;
  }
  .group-head h2 {
    font-size: clamp(1.625rem, 1.3rem + 1.2vw, 2.25rem);
  }
  .group-head p {
    color: var(--ink-2);
  }
  .team-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-7) var(--s-5);
  }
  @media (min-width: 800px) {
    .team-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .team-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
