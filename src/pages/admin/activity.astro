---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Forbidden from '../../components/admin/Forbidden.astro';
import { can } from '../../lib/cms/permissions';
import { one, query } from '../../lib/server/db';
import { ACTION_LABELS, describeActivity, type ActivityRow } from '../../lib/server/activity';
import { isUuid } from '../../lib/server/validate';

const admin = Astro.locals.admin!;
const allowed = can(admin, 'activity', 'view');
const sp = Astro.url.searchParams;
const who = sp.get('admin') ?? '';
const action = sp.get('action') ?? '';
const type = sp.get('type') ?? '';
const page = Math.max(1, Number(sp.get('page')) || 1);
const perPage = 50;

let rows: ActivityRow[] = [];
let total = 0;
let admins: { id: string; name: string }[] = [];
if (allowed) {
  const where: string[] = [];
  const args: unknown[] = [];
  if (isUuid(who)) where.push(`admin_id = $${args.push(who)}`);
  if (action && Object.hasOwn(ACTION_LABELS, action)) where.push(`action = $${args.push(action)}`);
  if (type && /^[a-z-]{1,40}$/.test(type)) where.push(`entity_type = $${args.push(type)}`);
  const w = where.length ? `WHERE ${where.join(' AND ')}` : '';
  total = (await one<{ n: number }>(`SELECT count(*)::int AS n FROM activity_log ${w}`, args))!.n;
  rows = await query<ActivityRow>(`SELECT * FROM activity_log ${w} ORDER BY created_at DESC LIMIT ${perPage} OFFSET ${(page - 1) * perPage}`, args);
  admins = await query('SELECT id, name FROM admins ORDER BY name');
}
const pages = Math.max(1, Math.ceil(total / perPage));
const link = (p: number) => {
  const u = new URLSearchParams(sp);
  u.set('page', String(p));
  return `?${u}`;
};
const TYPES: Record<string, string> = {
  pages: 'Pages',
  news: 'Articles',
  'news-categories': 'News categories',
  events: 'Events',
  programmes: 'Programmes',
  albums: 'Activities',
  team: 'Team members',
  'team-groups': 'Boards',
  partners: 'Partners',
  media: 'Media',
  enquiry: 'Enquiries',
  navigation: 'Navigation',
  settings: 'Settings',
  admin: 'Administrators',
};
const when = (d: string | Date) => new Date(d).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Brussels' });
---

<AdminLayout title="Activity log" active="admins">
  {
    allowed ? (
      <>
        <div class="page-head">
          <div>
            <div class="crumbs">
              <a href="/admin/admins/">Administrators</a> / Activity log
            </div>
            <h1>Activity log</h1>
            <p>Every sign-in, change, publication and deletion in the dashboard, newest first. Times are Brussels time.</p>
          </div>
        </div>
        <section class="card">
          <form class="toolbar" method="get">
            <select name="admin" aria-label="Administrator">
              <option value="">Everyone</option>
              {admins.map((a) => (
                <option value={a.id} selected={a.id === who}>
                  {a.name}
                </option>
              ))}
            </select>
            <select name="action" aria-label="Action">
              <option value="">All actions</option>
              {Object.entries(ACTION_LABELS).map(([k, v]) => (
                <option value={k} selected={k === action}>
                  {v.charAt(0).toUpperCase() + v.slice(1)}
                </option>
              ))}
            </select>
            <select name="type" aria-label="Content type">
              <option value="">All content</option>
              {Object.entries(TYPES).map(([k, v]) => (
                <option value={k} selected={k === type}>
                  {v}
                </option>
              ))}
            </select>
            <button class="btn btn--ghost btn--sm" type="submit">Filter</button>
            {(who || action || type) && (
              <a class="btn btn--link btn--sm" href="/admin/activity/">
                Clear
              </a>
            )}
            <span class="muted grow" style="text-align:right">{total.toLocaleString('en-GB')} entries</span>
          </form>
          <div class="table-wrap">
            <table class="data">
              <thead>
                <tr>
                  <th>When</th>
                  <th>Who</th>
                  <th>What</th>
                  <th>IP address</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((r) => {
                  const d = describeActivity(r);
                  return (
                    <tr>
                      <td class="nowrap muted">{when(r.created_at)}</td>
                      <td class="nowrap">{r.admin_name ?? '—'}</td>
                      <td>
                        {d.verb.charAt(0).toUpperCase() + d.verb.slice(1)} {d.noun}{' '}
                        {d.label && (d.href ? <a href={d.href}>{d.label}</a> : <strong>{d.label}</strong>)}
                        {r.action === 'login_failed' && r.details && <span class="muted"> ({String((r.details as any).reason ?? (r.details as any).email ?? '')})</span>}
                      </td>
                      <td class="nowrap muted">{r.ip ?? ''}</td>
                    </tr>
                  );
                })}
                {!rows.length && (
                  <tr>
                    <td colspan="4" class="muted" style="text-align:center;padding:32px">
                      No matching activity.
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
          {pages > 1 && (
            <div class="pager">
              {page > 1 ? <a class="btn btn--ghost btn--sm" href={link(page - 1)}>Previous</a> : <span />}
              <span class="muted">
                Page {page} of {pages}
              </span>
              {page < pages ? <a class="btn btn--ghost btn--sm" href={link(page + 1)}>Next</a> : <span />}
            </div>
          )}
        </section>
      </>
    ) : (
      <Forbidden />
    )
  }
</AdminLayout>
