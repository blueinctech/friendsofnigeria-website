---
/**
 * First-time setup page. The same form also appears on /admin/login/ while no
 * administrator exists. Disabled for good once an administrator exists.
 */
import AdminAuthLayout from '../../layouts/AdminAuthLayout.astro';
import SetupForm from '../../components/admin/SetupForm.astro';
import { countAdmins } from '../../lib/server/auth';
import { runSetup, setupEnabled } from '../../lib/server/setup';
import { clientIp } from '../../lib/server/http';

if ((await countAdmins()) > 0) return Astro.redirect('/admin/login/');

let state = { error: '', name: '', email: '' };
if (Astro.request.method === 'POST') {
  const r = await runSetup(await Astro.request.formData(), clientIp(Astro));
  if (r.done) return Astro.redirect('/admin/login/?setup=1', 303);
  state = r;
}
---

<AdminAuthLayout title="First-time setup">
  <img src="/icon-192.png" alt="" width="48" height="48" />
  <h1>Create the first administrator</h1>
  <SetupForm enabled={setupEnabled()} error={state.error} name={state.name} email={state.email} action="/admin/setup/" />
</AdminAuthLayout>
