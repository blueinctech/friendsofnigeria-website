---
import AdminAuthLayout from '../../layouts/AdminAuthLayout.astro';
import { countAdmins, login } from '../../lib/server/auth';
import { clientIp, SESSION_COOKIE, sessionCookieOptions } from '../../lib/server/http';
import SetupForm from '../../components/admin/SetupForm.astro';
import { runSetup, setupEnabled } from '../../lib/server/setup';

const safeNext = (v: unknown) => {
  const s = String(v ?? '');
  return s.startsWith('/admin/') && !s.startsWith('//') && !s.includes('\\') ? s : '/admin/';
};

if (Astro.locals.admin) return Astro.redirect(safeNext(Astro.url.searchParams.get('next')));

let error = '';
let email = '';
let setupState = { error: '', name: '', email: '' };
const next = safeNext(Astro.url.searchParams.get('next'));

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('intent') === 'setup') {
    // First-time setup, offered on this page while no administrator exists.
    const r = await runSetup(form, clientIp(Astro));
    if (r.done) return Astro.redirect('/admin/login/?setup=1', 303);
    setupState = r;
    Astro.response.status = 400;
  } else {
    email = String(form.get('email') ?? '').slice(0, 254);
    const result = await login(email, form.get('password'), clientIp(Astro), Astro.request.headers.get('user-agent'));
    if (result.ok) {
      Astro.cookies.set(SESSION_COOKIE, result.token, sessionCookieOptions(Astro.url));
      return Astro.redirect(safeNext(form.get('next')), 303);
    }
    error = result.error;
    Astro.response.status = result.status;
    if (result.retryAfter) Astro.response.headers.set('Retry-After', String(result.retryAfter));
  }
}

const noAdmins = (await countAdmins()) === 0;
const notice =
  Astro.url.searchParams.get('reset') === '1'
    ? 'Your password has been updated. Sign in with your new password.'
    : Astro.url.searchParams.get('out') === '1'
      ? 'You have been signed out.'
      : Astro.url.searchParams.get('setup') === '1'
        ? 'Your administrator account is ready. Sign in to continue.'
        : '';
---

{
  noAdmins ? (
    <AdminAuthLayout title="First-time setup">
      <img src="/icon-192.png" alt="" width="48" height="48" />
      <h1>Create the first administrator</h1>
      <SetupForm enabled={setupEnabled()} error={setupState.error} name={setupState.name} email={setupState.email} action="/admin/login/" />
    </AdminAuthLayout>
  ) : (
<AdminAuthLayout title="Sign in">
  <img src="/icon-192.png" alt="" width="48" height="48" />
  <h1>Sign in to the dashboard</h1>
  <p class="sub">Use the email address and password of your administrator account.</p>
  {notice && <p class="notice notice--green">{notice}</p>}
  {error && <p class="form-error" role="alert">{error}</p>}
  <form method="post" data-busy>
    <input type="hidden" name="next" value={next} />
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required autocomplete="username" value={email} autofocus={!email} />
    </div>
    <div class="field">
      <label for="password">Password</label>
      <div class="pw-wrap">
        <input id="password" name="password" type="password" required autocomplete="current-password" autofocus={Boolean(email)} />
        <button type="button" class="btn btn--link btn--sm" data-reveal-pw aria-pressed="false" style="padding:0 8px">Show</button>
      </div>
    </div>
    <button type="submit" class="btn btn--block">Sign in</button>
  </form>
  <div class="auth-links">
    <a href="/admin/forgot-password/">Forgot your password?</a>
    <a href="/">Back to the website</a>
  </div>
</AdminAuthLayout>
  )
}
