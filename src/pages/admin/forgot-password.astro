---
import AdminAuthLayout from '../../layouts/AdminAuthLayout.astro';
import { isEmail, normaliseEmail } from '../../lib/server/auth';
import { issuePasswordLink } from '../../lib/server/admins';
import { one } from '../../lib/server/db';
import { mailConfigured } from '../../lib/server/mail';
import { rateLimit, sha256 } from '../../lib/server/security';
import { logActivity } from '../../lib/server/activity';
import { clientIp } from '../../lib/server/http';

let sent = false;
let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = normaliseEmail(form.get('email'));
  const ip = clientIp(Astro) ?? 'unknown';
  if (!isEmail(email)) {
    error = 'Enter the email address of your administrator account.';
  } else {
    const ipLimit = await rateLimit(`forgot-ip:${ip}`, 5, 900);
    const emailLimit = await rateLimit(`forgot-email:${sha256(email)}`, 3, 3600);
    if (ipLimit.allowed && emailLimit.allowed) {
      const admin = await one<{ id: string; email: string; name: string }>('SELECT id, email, name FROM admins WHERE lower(email) = $1 AND active', [email]);
      if (admin) {
        const result = await issuePasswordLink(admin, Astro.url.origin, { createdBy: null, welcome: false, hours: 1 });
        await logActivity({ id: admin.id, name: admin.name }, { action: 'password_reset_requested', entityType: 'admin', entityId: admin.id, entityLabel: admin.email, details: { emailed: result.emailed }, ip });
        if (!result.emailed && import.meta.env.DEV) console.info(`[dev] Password reset link for ${admin.email}: ${result.link}`);
      }
    }
    // Same answer whether or not the account exists, so emails cannot be discovered.
    sent = true;
  }
}
---

<AdminAuthLayout title="Reset your password">
  <img src="/icon-192.png" alt="" width="48" height="48" />
  <h1>Reset your password</h1>
  {
    sent ? (
      <>
        <p class="notice notice--green">If an active account uses that address, we have emailed it a link to choose a new password. The link expires in one hour.</p>
        <p class="sub">
          {mailConfigured()
            ? 'Check your spam folder if it does not arrive within a few minutes.'
            : 'Email is not set up on this website yet, so no message can be sent. Ask a super administrator to create a password link for you from Administrators.'}
        </p>
        <a href="/admin/login/" class="btn btn--block">Back to sign in</a>
      </>
    ) : (
      <>
        <p class="sub">Enter your account’s email address and we will send you a link to choose a new password.</p>
        {error && <p class="form-error" role="alert">{error}</p>}
        <form method="post" data-busy>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required autocomplete="username" autofocus />
          </div>
          <button type="submit" class="btn btn--block">Send reset link</button>
        </form>
        <div class="auth-links">
          <a href="/admin/login/">Back to sign in</a>
        </div>
      </>
    )
  }
</AdminAuthLayout>
