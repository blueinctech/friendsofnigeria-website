---
import AdminAuthLayout from '../../layouts/AdminAuthLayout.astro';
import { consumeResetToken, findResetToken } from '../../lib/server/auth';
import { rateLimit } from '../../lib/server/security';
import { logActivity } from '../../lib/server/activity';
import { clientIp } from '../../lib/server/http';

let token = Astro.url.searchParams.get('token') ?? '';
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  token = String(form.get('token') ?? '');
  const password = String(form.get('password') ?? '');
  const confirm = String(form.get('confirm') ?? '');
  const limit = await rateLimit(`reset-ip:${clientIp(Astro) ?? 'unknown'}`, 10, 900);
  if (!limit.allowed) error = 'Too many attempts. Please wait 15 minutes.';
  else if (password !== confirm) error = 'The two passwords do not match.';
  else {
    const result = await consumeResetToken(token, password);
    if (result.ok) {
      await logActivity({ id: result.adminId, name: result.name }, { action: 'password_reset', entityType: 'admin', entityId: result.adminId, entityLabel: result.email, ip: clientIp(Astro) });
      return Astro.redirect('/admin/login/?reset=1', 303);
    }
    error = result.error;
  }
}

const valid = token ? await findResetToken(token) : null;
---

<AdminAuthLayout title="Choose a new password">
  <img src="/icon-192.png" alt="" width="48" height="48" />
  <h1>Choose a password</h1>
  {
    !valid ? (
      <>
        <p class="form-error" role="alert">This link has expired or has already been used.</p>
        <a href="/admin/forgot-password/" class="btn btn--block">Request a new link</a>
      </>
    ) : (
      <>
        <p class="sub">For {valid.email}. Use at least 12 characters; a short sentence is easy to remember and hard to guess.</p>
        {error && <p class="form-error" role="alert">{error}</p>}
        <form method="post" data-busy>
          <input type="hidden" name="token" value={token} />
          <input type="email" name="username" value={valid.email} autocomplete="username" hidden />
          <div class="field">
            <label for="password">New password</label>
            <div class="pw-wrap">
              <input id="password" name="password" type="password" required minlength="12" maxlength="200" autocomplete="new-password" autofocus />
              <button type="button" class="btn btn--link btn--sm" data-reveal-pw aria-pressed="false" style="padding:0 8px">Show</button>
            </div>
          </div>
          <div class="field">
            <label for="confirm">Repeat the password</label>
            <input id="confirm" name="confirm" type="password" required minlength="12" maxlength="200" autocomplete="new-password" />
          </div>
          <button type="submit" class="btn btn--block">Save password</button>
        </form>
      </>
    )
  }
</AdminAuthLayout>
