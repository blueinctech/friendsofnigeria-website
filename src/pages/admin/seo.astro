---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Forbidden from '../../components/admin/Forbidden.astro';
import SettingsEditor from '../../components/admin/SettingsEditor';
import Icon from '../../components/admin/Icon';
import { can } from '../../lib/cms/permissions';
import { one, query } from '../../lib/server/db';

const admin = Astro.locals.admin!;
const allowed = can(admin, 'seo', 'view');

type Issue = { type: string; id: string; title: string; problem: string };
let issues: Issue[] = [];
let missingAlt = 0;
let noindex = 0;
if (allowed) {
  // Published content that has neither its own meta description nor a summary to fall back on,
  // or whose SEO title is longer than search engines show.
  issues = await query<Issue>(`
    SELECT 'pages' AS type, id, title,
           CASE WHEN coalesce(seo_description, '') = '' AND coalesce(lead, '') = '' THEN 'No meta description or lead text'
                ELSE 'SEO title longer than 60 characters' END AS problem
      FROM pages WHERE status = 'published' AND key IS DISTINCT FROM 'not-found'
       AND ((coalesce(seo_description, '') = '' AND coalesce(lead, '') = '') OR length(coalesce(seo_title, '')) > 60)
    UNION ALL
    SELECT 'news', id, title,
           CASE WHEN coalesce(seo_description, '') = '' AND excerpt = '' THEN 'No meta description or summary'
                WHEN image IS NULL AND og_image IS NULL THEN 'No image for social sharing'
                ELSE 'SEO title longer than 60 characters' END
      FROM news WHERE status = 'published'
       AND ((coalesce(seo_description, '') = '' AND excerpt = '') OR (image IS NULL AND og_image IS NULL) OR length(coalesce(seo_title, '')) > 60)
    UNION ALL
    SELECT 'events', id, title,
           CASE WHEN coalesce(seo_description, '') = '' AND summary = '' THEN 'No meta description or summary'
                ELSE 'SEO title longer than 60 characters' END
      FROM events WHERE status = 'published'
       AND ((coalesce(seo_description, '') = '' AND summary = '') OR length(coalesce(seo_title, '')) > 60)
    UNION ALL
    SELECT 'programmes', id, title,
           CASE WHEN coalesce(seo_description, '') = '' AND summary = '' THEN 'No meta description or summary'
                ELSE 'SEO title longer than 60 characters' END
      FROM programmes WHERE status = 'published'
       AND ((coalesce(seo_description, '') = '' AND summary = '') OR length(coalesce(seo_title, '')) > 60)
    ORDER BY 1, 3 LIMIT 100`);
  missingAlt = (await one<{ n: number }>(`SELECT count(*)::int AS n FROM media WHERE kind = 'image' AND coalesce(alt, '') = ''`))!.n;
  noindex = (await one<{ n: number }>(`SELECT count(*)::int AS n FROM pages WHERE noindex AND status = 'published'`))!.n;
}
const TYPE_LABEL: Record<string, string> = { pages: 'Page', news: 'Article', events: 'Event', programmes: 'Programme' };
---

<AdminLayout title="SEO Settings" active="seo">
  {
    allowed ? (
      <>
        <div class="page-head">
          <div>
            <h1>SEO Settings</h1>
            <p>Defaults used by search engines and social networks across the site. Each page, article, event and programme also has its own SEO fields in its editor.</p>
          </div>
          <div class="head-actions">
            <a class="btn btn--ghost" href="/sitemap-index.xml" target="_blank" rel="noopener"><Icon name="globe" size={16} /> Sitemap</a>
            <a class="btn btn--ghost" href="/robots.txt" target="_blank" rel="noopener"><Icon name="file" size={16} /> robots.txt</a>
          </div>
        </div>

        <section class="card" style="margin-bottom:16px">
          <div class="card-head">
            <div>
              <h2>Health check</h2>
              <p>Checked live against the published content.</p>
            </div>
          </div>
          <div class="card-body">
            <ul class="list-plain">
              <li>
                <span>Images without a description (alt text)</span>
                {missingAlt ? <a class="badge badge--amber" href="/admin/media/?missingAlt=1">{missingAlt} to describe</a> : <span class="badge badge--green">All described</span>}
              </li>
              <li>
                <span>Published pages hidden from search engines</span>
                <span class={`badge ${noindex ? 'badge--blue' : 'badge--green'}`}>{noindex}</span>
              </li>
              <li>
                <span>Published content needing attention</span>
                <span class={`badge ${issues.length ? 'badge--amber' : 'badge--green'}`}>{issues.length || 'None'}</span>
              </li>
            </ul>
            {issues.length > 0 && (
              <div class="table-wrap" style="margin-top:12px">
                <table class="data">
                  <thead>
                    <tr>
                      <th>Content</th>
                      <th>Type</th>
                      <th>Issue</th>
                    </tr>
                  </thead>
                  <tbody>
                    {issues.map((i) => (
                      <tr>
                        <td>
                          <a href={`/admin/${i.type}/${i.id}/`}>{i.title}</a>
                        </td>
                        <td>{TYPE_LABEL[i.type]}</td>
                        <td class="muted">{i.problem}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        </section>

        <SettingsEditor client:load settingsKey="seo" previewUrl="/" />
      </>
    ) : (
      <Forbidden />
    )
  }
</AdminLayout>
