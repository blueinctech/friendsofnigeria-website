---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getPage, iconName, img, listProgrammes, pageSeo } from '../../lib/server/public';

const preview = Astro.locals.preview;
const page = await getPage('what-we-do', preview);
if (!page) return Astro.rewrite('/404/');
const areas = await listProgrammes('area', preview);
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<BaseLayout {...pageSeo(page)}>
  <PageHero title={page.title} lead={page.lead} crumbs={[{ label: page.title }]}>
    <ol class="toc" role="list">
      {
        areas.map((a, i) => (
          <li>
            <a href={`#${a.slug}`}>
              <span>{num(i)}</span>
              {a.title}
            </a>
          </li>
        ))
      }
    </ol>
  </PageHero>

  <section class="section">
    <div class="container rows">
      {
        areas.map((a, i) => (
          <article class:list={['row', { 'row--flip': i % 2 === 1 }]} id={a.slug}>
            <div class="media media--zoom row-media" data-reveal="image" data-parallax>
              {a.image && <img {...img(a.image, { alt: a.image_alt, sizes: '(min-width: 1000px) 620px, 100vw', loading: i === 0 ? 'eager' : 'lazy' })} />}
            </div>
            <div class="row-copy" data-reveal>
              <span class="row-icon">
                <Icon name={iconName(a.icon)} size={22} />
              </span>
              <h2>{a.title}</h2>
              {a.headline && <p class="row-headline">{a.headline}</p>}
              <p>{a.summary}</p>
              <a href={a.path} class="link-arrow">
                Learn more<span class="visually-hidden"> about {a.title.toLowerCase()}</span> <Icon name="arrow-right" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .toc {
    list-style: none;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--line);
  }
  .toc a {
    display: flex;
    gap: var(--s-4);
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-2);
  }
  .toc a span {
    color: var(--slate-400);
    font-variant-numeric: tabular-nums;
  }
  .toc a:hover {
    color: var(--accent-ink);
  }
  .rows {
    display: grid;
    gap: clamp(4rem, 3rem + 4vw, 7rem);
  }
  .row {
    display: grid;
    gap: var(--s-6);
    align-items: center;
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  @media (min-width: 1000px) {
    .row {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--s-9);
    }
    .row--flip .row-media {
      order: 2;
    }
  }
  .row-media {
    aspect-ratio: 3 / 2;
  }
  .row-copy {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }
  .row-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--r-sm);
    background: var(--green-50);
    color: var(--green-700);
    margin-bottom: var(--s-2);
  }
  .row-headline {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    letter-spacing: -0.015em;
    color: var(--ink-2);
    line-height: 1.35;
  }
  .row-copy > p:not(.row-headline) {
    color: var(--ink-2);
    max-width: 54ch;
  }
</style>
