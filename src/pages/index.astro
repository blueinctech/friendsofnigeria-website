<script>
  // Hero slideshow: crossfade between event photos every few seconds.
  // Lazy-loads each upcoming photo and waits until it is decoded before
  // fading it in, pauses when off screen or in a background tab, and never
  // starts for visitors who prefer reduced motion.
  const show = document.querySelector<HTMLElement>('[data-slideshow]');
  if (show && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const slides = Array.from(show.querySelectorAll<HTMLElement>('[data-slide]'));
    const toggle = show.querySelector<HTMLButtonElement>('[data-slideshow-toggle]');
    const HOLD = 5000;
    const FADE = 1600;
    let index = 0;
    let timer = 0;
    let paused = false;
    let visible = true;

    const load = (slide: HTMLElement) => {
      const img = slide.querySelector('img')!;
      if (img.dataset.src) {
        img.srcset = img.dataset.srcset ?? '';
        img.src = img.dataset.src;
        delete img.dataset.src;
        delete img.dataset.srcset;
      }
      return img.decode().catch(() => undefined);
    };

    const restartRing = () => {
      if (!toggle) return;
      toggle.classList.remove('is-timing');
      void toggle.offsetWidth;
      if (!paused && visible) toggle.classList.add('is-timing');
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (paused || !visible || document.hidden) return;
      restartRing();
      // Warm up the photo after the next one while this one is on screen.
      load(slides[(index + 1) % slides.length]);
      timer = window.setTimeout(advance, HOLD);
    };

    const advance = async () => {
      const prev = slides[index];
      const nextIndex = (index + 1) % slides.length;
      const next = slides[nextIndex];
      await load(next);
      if (paused || !visible) return;
      next.classList.remove('is-leaving');
      next.classList.add('is-active');
      next.removeAttribute('aria-hidden');
      prev.classList.remove('is-active');
      prev.classList.add('is-leaving');
      prev.setAttribute('aria-hidden', 'true');
      index = nextIndex;
      window.setTimeout(() => {
        prev.classList.remove('is-leaving', 'is-first');
      }, FADE + 50);
      schedule();
    };

    if (slides.length > 1) {
      show.style.setProperty('--slide-ms', `${HOLD}ms`);
      if (toggle) {
        toggle.hidden = false;
        toggle.setAttribute('aria-pressed', 'false');
        toggle.addEventListener('click', () => {
          paused = !paused;
          toggle.setAttribute('aria-pressed', String(paused));
          toggle.setAttribute('aria-label', paused ? 'Play slideshow' : 'Pause slideshow');
          if (paused) {
            window.clearTimeout(timer);
            toggle.classList.remove('is-timing');
          } else {
            schedule();
          }
        });
      }
      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          if (visible) schedule();
          else {
            window.clearTimeout(timer);
            toggle?.classList.remove('is-timing');
          }
        },
        { threshold: 0.15 },
      ).observe(show);
      document.addEventListener('visibilitychange', () => (document.hidden ? window.clearTimeout(timer) : schedule()));
      // Let the opening animation finish before the first change.
      window.setTimeout(() => {
        load(slides[1]);
        schedule();
      }, 1800);
    }
  }

  // "What we do": swap the preview image as the visitor moves through the list.
  const root = document.querySelector<HTMLElement>('[data-areas]');
  if (root) {
    const items = root.querySelectorAll<HTMLElement>('[data-area]');
    const imgs = root.querySelectorAll<HTMLElement>('[data-area-img]');
    const activate = (i: string) => {
      imgs.forEach((img) => img.classList.toggle('is-active', img.dataset.areaImg === i));
      items.forEach((it) => it.classList.toggle('is-active', it.dataset.area === i));
    };
    items.forEach((it) => {
      it.addEventListener('mouseenter', () => activate(it.dataset.area!));
      it.addEventListener('focusin', () => activate(it.dataset.area!));
    });
    activate('0');
  }

  // Hero: pointer parallax on the photo layers, and a soft hand-off as the hero scrolls away.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (hero && reduce) {
    hero.querySelectorAll<SVGSVGElement>('svg').forEach((svg) => svg.pauseAnimations?.());
  }
  if (hero && !reduce) {
    const layers = Array.from(hero.querySelectorAll<HTMLElement>('[data-depth]'));
    const finePointer = window.matchMedia('(pointer: fine) and (min-width: 1100px)');
    let tx = 0, ty = 0, cx = 0, cy = 0, sy = 0, raf = 0;
    const render = () => {
      cx += (tx - cx) * 0.075;
      cy += (ty - cy) * 0.075;
      layers.forEach((l) => {
        const d = Number(l.dataset.depth);
        l.style.transform = `translate3d(${(cx * d * 9).toFixed(2)}px, ${(cy * d * 7 - sy * d * 0.035).toFixed(2)}px, 0)`;
      });
      if (Math.abs(tx - cx) > 0.001 || Math.abs(ty - cy) > 0.001) raf = requestAnimationFrame(render);
      else raf = 0;
    };
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(render);
    };
    hero.addEventListener('pointermove', (e) => {
      if (!finePointer.matches) return;
      const r = hero.getBoundingClientRect();
      tx = ((e.clientX - r.left) / r.width - 0.5) * 2;
      ty = ((e.clientY - r.top) / r.height - 0.5) * 2;
      kick();
    });
    hero.addEventListener('pointerleave', () => {
      tx = 0;
      ty = 0;
      kick();
    });
    let ticking = false;
    const onScroll = () => {
      const h = hero.offsetHeight;
      const y = window.scrollY;
      if (y > h * 1.2 && sy > h) return (ticking = false);
      sy = y;
      hero.style.setProperty('--hp', Math.min(1, Math.max(0, y / h)).toFixed(3));
      kick();
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(onScroll);
        }
      },
      { passive: true },
    );
  }
</script>
