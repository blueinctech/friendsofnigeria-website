<script>
  // "What we do": swap the preview image as the visitor moves through the list.
  const root = document.querySelector<HTMLElement>('[data-areas]');
  if (root) {
    const items = root.querySelectorAll<HTMLElement>('[data-area]');
    const imgs = root.querySelectorAll<HTMLElement>('[data-area-img]');
    const activate = (i: string) => {
      imgs.forEach((img) => img.classList.toggle('is-active', img.dataset.areaImg === i));
      items.forEach((it) => it.classList.toggle('is-active', it.dataset.area === i));
    };
    items.forEach((it) => {
      it.addEventListener('mouseenter', () => activate(it.dataset.area!));
      it.addEventListener('focusin', () => activate(it.dataset.area!));
    });
    activate('0');
  }

  // Gentle parallax on hero accents.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const layers = document.querySelectorAll<HTMLElement>('[data-parallax]');
  if (!reduce && layers.length && window.matchMedia('(min-width: 1000px)').matches) {
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      layers.forEach((l) => {
        l.style.translate = `0 ${(y * Number(l.dataset.parallax)).toFixed(1)}px`;
      });
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking && window.scrollY < 900) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>
