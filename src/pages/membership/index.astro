---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import MembershipEnquiryForm from '../../components/forms/MembershipEnquiryForm.astro';
import { getPage, getSite, iconName, img, listProgrammes, pageSeo } from '../../lib/server/public';

const preview = Astro.locals.preview;
const page = await getPage('membership', preview);
if (!page) return Astro.rewrite('/404/');
const c = page.content;
const { site } = await getSite(Astro.locals);
const plans = await listProgrammes('membership', preview);
const stepsImg = img(page.media[c.steps_image], { alt: c.steps_image_alt, sizes: '(min-width: 1000px) 520px, 100vw' });
const planIcon = (slug: string, icon: string | null) => (slug === 'fonen' ? 'building' : slug === 'fonpro' ? 'user' : iconName(icon, 'users'));
---

<BaseLayout {...pageSeo(page)}>
  <PageHero title={page.title} lead={page.lead} crumbs={[{ label: page.title }]}>
    <div class="btn-row">
      <a href="#platforms" class="btn">Compare memberships <Icon name="arrow-right" size={16} class="arrow" /></a>
      <a href="#enquire" class="btn btn--ghost">Ask a question</a>
    </div>
  </PageHero>

  <section class="section" id="platforms">
    <div class="container">
      <div class="plans">
        {
          plans.map((p, i) => (
            <article class="plan spotlight lift" data-reveal style={i ? `--reveal-delay:${i * 100}` : undefined}>
              <span class="plan-icon"><Icon name={planIcon(p.slug, p.icon)} size={24} /></span>
              {p.audience && <span class="tag">{p.audience}</span>}
              <h2>
                {p.title}
                {p.full_name && <span>{p.full_name}</span>}
              </h2>
              <p>{p.summary}</p>
              {p.details && <p class="muted">{p.details}</p>}
              <ul class="rows" role="list">
                {p.categories.length > 0
                  ? p.categories.map((cat) => (
                      <li>
                        <span>{cat.name} membership</span>
                        <strong>{cat.fee}</strong>
                      </li>
                    ))
                  : /helloasso/i.test(p.secondary_link_url ?? '') && (
                      <li>
                        <span>Registration and payment</span>
                        <strong>Secure, via HelloAsso</strong>
                      </li>
                    )}
              </ul>
              <div class="btn-row">
                <a href={p.link_url?.startsWith('#') ? `${p.path}${p.link_url}` : p.path} class="btn">
                  {p.link_label || `About ${p.title}`} <Icon name="arrow-right" size={16} class="arrow" />
                </a>
                <a href={`${p.path}#about`} class="btn btn--ghost">
                  Learn more
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container how">
      <div class="media how-media" data-reveal="image" data-parallax>
        {stepsImg && <img {...stepsImg} />}
      </div>
      <div>
        <h2 data-reveal>{c.steps_heading}</h2>
        <ol class="steps" role="list">
          {
            (c.steps ?? []).map((s: { title: string; text: string }, i: number) => (
              <li data-reveal style={`--reveal-delay:${i * 80}`}>
                <span class="step-n">{i + 1}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section" id="enquire">
    <div class="container enquire">
      <div class="enquire-intro">
        <h2 data-reveal>{c.enquire_heading}</h2>
        {c.enquire_lead && <p class="lead" data-reveal>{c.enquire_lead}</p>}
        {site.email && (
          <p class="contact-alt" data-reveal>
            Prefer email? Write to <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        )}
      </div>
      <div class="form-card spotlight" data-reveal style="--reveal-delay:100">
        <MembershipEnquiryForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .plans {
    display: grid;
    gap: var(--s-5);
  }
  @media (min-width: 900px) {
    .plans {
      grid-template-columns: 1fr 1fr;
    }
  }
  .plan {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
    padding: clamp(1.75rem, 1.25rem + 2vw, 3rem);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }
  .plan-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: var(--r-sm);
    background: var(--green-50);
    color: var(--green-700);
  }
  .plan h2 {
    font-size: var(--fs-h2);
  }
  .plan h2 span {
    display: block;
    margin-top: 6px;
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink-3);
  }
  .plan > p {
    color: var(--ink-2);
  }
  .plan > .btn-row {
    margin-top: auto;
  }
  .plan .muted {
    font-size: var(--fs-sm);
    color: var(--ink-3);
  }
  .rows {
    list-style: none;
    padding: 0;
    width: 100%;
    border-top: 1px solid var(--line);
  }
  .rows li {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .rows strong {
    color: var(--ink);
    font-weight: 600;
  }
  .how {
    display: grid;
    gap: var(--s-7);
    align-items: center;
  }
  @media (min-width: 1000px) {
    .how {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-9);
    }
  }
  .how-media {
    aspect-ratio: 4 / 3;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin-top: var(--s-6);
    display: grid;
  }
  .steps li {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: var(--s-4);
    padding: var(--s-5) 0;
    border-top: 1px solid var(--line-strong);
  }
  .step-n {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .steps h3 {
    font-size: var(--fs-h4);
  }
  .steps p {
    margin-top: 4px;
    color: var(--ink-2);
  }
  .enquire {
    display: grid;
    gap: var(--s-7);
  }
  @media (min-width: 1000px) {
    .enquire {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--s-9);
      align-items: start;
    }
    .enquire-intro {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }
  .enquire-intro {
    display: grid;
    gap: var(--s-4);
  }
  .contact-alt {
    font-size: var(--fs-sm);
    color: var(--ink-3);
  }
  .contact-alt a {
    color: var(--accent-ink);
  }
  .form-card {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }
</style>
