---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import site from '../data/site.json';

const c = site.contact;
const mapQuery = encodeURIComponent(`${c.address}, ${c.postcode} ${c.city}, ${c.country}`);
---

<BaseLayout title="Contact us" description="Get in touch with Friends of Nigeria in Paris about membership, partnerships, Spotlight Nigeria, NIDA or press enquiries.">
  <PageHero title="Contact us" lead="Questions about membership, partnerships, our events or the press? Write to us and the right person on our team will reply." crumbs={[{ label: 'Contact us' }]} />

  <section class="section">
    <div class="container contact">
      <aside class="details" aria-label="Contact details">
        <div class="detail" data-reveal>
          <span class="d-icon"><Icon name="mail" size={20} /></span>
          <div>
            <h2>Email</h2>
            <a href={`mailto:${c.email}`}>{c.email}</a>
          </div>
        </div>
        <div class="detail" data-reveal style="--reveal-delay:60">
          <span class="d-icon"><Icon name="phone" size={20} /></span>
          <div>
            <h2>Phone</h2>
            <ul role="list">
              {c.phones.map((p) => <li><span>{p.label}</span> <a href={`tel:${p.tel}`}>{p.display}</a></li>)}
            </ul>
          </div>
        </div>
        <div class="detail" data-reveal style="--reveal-delay:120">
          <span class="d-icon"><Icon name="map-pin" size={20} /></span>
          <div>
            <h2>Office</h2>
            <address>{c.address}<br />{c.postcode} {c.city}, {c.country}</address>
            <p class="note">{c.note}</p>
            <a class="link-arrow" href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} target="_blank" rel="noopener noreferrer">Open in Google Maps <Icon name="arrow-up-right" size={14} /></a>
          </div>
        </div>
        <div class="detail" data-reveal style="--reveal-delay:180">
          <span class="d-icon"><Icon name="globe" size={20} /></span>
          <div>
            <h2>Follow us</h2>
            <ul class="social" role="list">
              {site.social.map((s) => <li><a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`${s.name} (opens in a new tab)`}><Icon name={s.name} size={16} /></a></li>)}
            </ul>
          </div>
        </div>
      </aside>
      <div class="form-card" data-reveal style="--reveal-delay:100">
        <h2 class="form-title">Send us a message</h2>
        <p class="form-sub">All fields are required unless marked optional.</p>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Preselect the subject when arriving from a link such as /contact/?topic=NIDA
  const topic = new URLSearchParams(location.search).get('topic');
  const select = document.querySelector<HTMLSelectElement>('#contact-topic');
  if (topic && select && Array.from(select.options).some((o) => o.value === topic)) select.value = topic;
</script>

<style>
  .contact {
    display: grid;
    gap: var(--s-8);
  }
  @media (min-width: 1000px) {
    .contact {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--s-9);
      align-items: start;
    }
  }
  .details {
    display: grid;
  }
  .detail {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: var(--s-4);
    padding: var(--s-5) 0;
    border-top: 1px solid var(--line);
  }
  .detail:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .d-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-sm);
    background: var(--green-50);
    color: var(--green-700);
  }
  .detail h2 {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 6px;
  }
  .detail a:not(.link-arrow) {
    color: var(--ink);
    text-decoration-color: var(--line-strong);
  }
  .detail ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .detail ul span {
    display: inline-block;
    min-width: 64px;
    color: var(--ink-3);
    font-size: var(--fs-sm);
  }
  address {
    font-style: normal;
  }
  .note {
    margin: 6px 0 10px;
    font-size: var(--fs-sm);
    color: var(--ink-3);
  }
  .detail .social {
    display: flex;
    gap: 8px;
    margin-top: 4px;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    color: var(--ink-2);
    transition: color 160ms var(--ease), border-color 160ms var(--ease);
  }
  .social a:hover {
    color: var(--green-700);
    border-color: var(--green-600);
  }
  .form-card {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }
  .form-title {
    font-size: var(--fs-h3);
  }
  .form-sub {
    margin: 6px 0 var(--s-5);
    font-size: var(--fs-sm);
    color: var(--ink-3);
  }
</style>
