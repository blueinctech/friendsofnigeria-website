---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PartnerGrid from '../components/PartnerGrid.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
const partners = (await getCollection('partners')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Partners and sponsors"
  description="The institutions, chambers of commerce and organisations that have partnered with and supported Friends of Nigeria and Spotlight Nigeria."
>
  <PageHero
    title="Partners and sponsors"
    lead="Our work is made possible by institutions in France, Europe and Nigeria that share our commitment to stronger economic and cultural ties."
    crumbs={[{ label: 'About us', href: '/about/' }, { label: 'Partners and sponsors' }]}
  />

  <section class="section">
    <div class="container">
      <PartnerGrid />
      <h2 class="visually-hidden">Partner list</h2>
      <ul class="names" role="list">
        {partners.map((p) => <li>{p.data.name}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container partner-cta">
      <div>
        <h2 data-reveal>Partner with Friends of Nigeria</h2>
        <p class="lead" data-reveal style="--reveal-delay:80">
          We work with public institutions, companies and organisations on events, trade missions, training and diaspora initiatives. Sponsoring
          Spotlight Nigeria gives your organisation direct access to business leaders, investors and decision-makers from Nigeria and Europe.
        </p>
      </div>
      <div class="btn-row" data-reveal style="--reveal-delay:140">
        <a href="/contact/?topic=Partnership%20or%20sponsorship" class="btn">Discuss a partnership <Icon name="arrow-right" size={16} class="arrow" /></a>
        <a href="https://spotlightnigeria-france.com/" class="btn btn--ghost" target="_blank" rel="noopener">Spotlight Nigeria sponsorship <Icon name="arrow-up-right" size={16} /><span class="visually-hidden"> (opens in a new tab)</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .names {
    list-style: none;
    padding: 0;
    margin-top: var(--s-7);
    columns: 1;
    column-gap: var(--s-7);
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .names li {
    break-inside: avoid;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 700px) {
    .names {
      columns: 2;
    }
  }
  @media (min-width: 1100px) {
    .names {
      columns: 3;
    }
  }
  .partner-cta {
    display: grid;
    gap: var(--s-6);
  }
  .partner-cta h2 {
    max-width: 20ch;
  }
  .partner-cta .lead {
    margin-top: var(--s-4);
    max-width: 62ch;
  }
  @media (min-width: 1000px) {
    .partner-cta {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: var(--s-9);
    }
  }
</style>
