---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PartnerGrid from '../components/PartnerGrid.astro';
import Icon from '../components/Icon.astro';
import { getPage, isExternal, listPartners, pageSeo } from '../lib/server/public';

const page = await getPage('partners', Astro.locals.preview);
if (!page) return Astro.rewrite('/404/');
const c = page.content;
const partners = await listPartners(Astro.locals.preview);
---

<BaseLayout {...pageSeo(page)}>
  <PageHero title={page.title} lead={page.lead} crumbs={[{ label: 'About us', href: '/about/' }, { label: page.title }]} image={page.hero} imageAlt={page.hero_alt} />

  <section class="section">
    <div class="container">
      <PartnerGrid partners={partners} />
      <h2 class="visually-hidden">Partner list</h2>
      <ul class="names" role="list">
        {partners.map((p) => <li>{p.name}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container partner-cta">
      <div>
        <h2 data-reveal>{c.cta_heading}</h2>
        {c.cta_text && <p class="lead" data-reveal style="--reveal-delay:80">{c.cta_text}</p>}
      </div>
      <div class="btn-row" data-reveal style="--reveal-delay:140">
        {c.cta_primary_label && <a href={c.cta_primary_url} class="btn">{c.cta_primary_label} <Icon name="arrow-right" size={16} class="arrow" /></a>}
        {
          c.cta_secondary_label &&
            (isExternal(c.cta_secondary_url) ? (
              <a href={c.cta_secondary_url} class="btn btn--ghost" target="_blank" rel="noopener">
                {c.cta_secondary_label} <Icon name="arrow-up-right" size={16} />
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            ) : (
              <a href={c.cta_secondary_url} class="btn btn--ghost">{c.cta_secondary_label}</a>
            ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .names {
    list-style: none;
    padding: 0;
    margin-top: var(--s-7);
    columns: 1;
    column-gap: var(--s-7);
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .names li {
    break-inside: avoid;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 700px) {
    .names {
      columns: 2;
    }
  }
  @media (min-width: 1100px) {
    .names {
      columns: 3;
    }
  }
  .partner-cta {
    display: grid;
    gap: var(--s-6);
  }
  .partner-cta h2 {
    max-width: 20ch;
  }
  .partner-cta .lead {
    margin-top: var(--s-4);
    max-width: 62ch;
  }
  @media (min-width: 1000px) {
    .partner-cta {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: var(--s-9);
    }
  }
</style>
