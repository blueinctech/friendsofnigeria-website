---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import { getPage, listAlbums, pageSeo } from '../../lib/server/public';

const preview = Astro.locals.preview;
const page = await getPage('gallery', preview);
if (!page) return Astro.rewrite('/404/');
const albums = await listAlbums(preview);
const total = albums.reduce((n, a) => n + a.photo_total, 0);
const flagship = albums.filter((a) => a.type === 'Flagship event');
const others = albums.filter((a) => a.type !== 'Flagship event');
const lead = (page.lead ?? '').replace('{albums}', String(albums.length)).replace('{photos}', String(total));
---

<BaseLayout {...pageSeo(page)} description={page.seo_description || lead}>
  <PageHero title={page.title} lead={lead} crumbs={[{ label: 'Our activities', href: '/our-activities/' }, { label: page.title }]} image={page.hero} imageAlt={page.hero_alt} />

  <section class="section">
    <div class="container">
      {flagship.length > 0 && <h2 class="group-title">{page.content.flagship_heading}</h2>}
      <ul class="album-grid" role="list">
        {
          flagship.map((a, i) => (
            <li data-reveal style={`--reveal-delay:${(i % 3) * 60}`}>
              <AlbumCard album={a} />
            </li>
          ))
        }
      </ul>
      {others.length > 0 && <h2 class="group-title">{page.content.others_heading}</h2>}
      <ul class="album-grid" role="list">
        {
          others.map((a, i) => (
            <li data-reveal style={`--reveal-delay:${(i % 3) * 60}`}>
              <AlbumCard album={a} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .group-title {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    margin-bottom: var(--s-6);
  }
  .album-grid + .group-title {
    margin-top: var(--s-9);
  }
  .album-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-7) var(--s-5);
  }
  @media (min-width: 640px) {
    .album-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .album-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
