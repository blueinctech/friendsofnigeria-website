---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  lead?: string;
  crumbs: { label: string; href?: string }[];
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
}
const { title, lead, crumbs, image, imageAlt = '', imagePosition = 'center' } = Astro.props;
---

<section class:list={['page-hero', { 'has-image': image }]}>
  <div class="ph-backdrop" aria-hidden="true"></div>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <div class="hero-grid">
      <h1 data-reveal>{title}</h1>
      {
        (lead || Astro.slots.has('default')) && (
          <div class="hero-side" data-reveal style="--reveal-delay:120">
            {lead && <p class="lead">{lead}</p>}
            <slot />
          </div>
        )
      }
    </div>
  </div>
  {
    image && (
      <div class="container hero-media-wrap">
        <div class="media hero-media" data-reveal="image" data-parallax>
          <Image
            src={image}
            alt={imageAlt}
            widths={[640, 960, 1280, 1600, 2000]}
            sizes="(min-width: 1320px) 1240px, 100vw"
            loading="eager"
            fetchpriority="high"
            style={`object-position:${imagePosition}`}
          />
        </div>
      </div>
    )
  }
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    padding-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding-bottom: clamp(3rem, 2rem + 4vw, 5.5rem);
    border-bottom: 1px solid var(--line);
  }
  /* Faint dot grid with a brand-green bloom, fading out toward the content. */
  .ph-backdrop {
    position: absolute;
    inset: 0 0 auto 0;
    height: min(560px, 100%);
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background:
      radial-gradient(600px 320px at 88% 0%, rgb(11 148 68 / 0.1), transparent 70%),
      radial-gradient(circle at 1px 1px, rgb(13 22 25 / 0.09) 1px, transparent 0) 0 0 / 22px 22px;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 92%);
    mask-image: linear-gradient(180deg, #000 0%, transparent 92%);
  }
  .page-hero.has-image {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .hero-grid {
    display: grid;
    gap: var(--s-5);
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }
  .hero-grid h1 {
    max-width: 16ch;
    font-size: clamp(2.5rem, 1.4rem + 4.2vw, 5rem);
    letter-spacing: -0.045em;
  }
  .hero-side {
    display: grid;
    gap: var(--s-5);
    align-content: end;
  }
  .hero-side .lead {
    max-width: 52ch;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--s-9);
      align-items: end;
    }
  }
  .hero-media-wrap {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  .hero-media {
    aspect-ratio: 16 / 9;
    max-height: 640px;
    width: 100%;
    border-radius: var(--r-lg);
    box-shadow: 0 40px 80px -48px rgb(13 22 25 / 0.5);
  }
  @media (max-width: 640px) {
    .hero-media {
      aspect-ratio: 4 / 3;
    }
  }
</style>
