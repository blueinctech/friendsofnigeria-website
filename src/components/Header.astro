---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/brand/logo.png';
import { mainNav, membershipNav } from '../data/navigation';
import site from '../data/site.json';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const activeIn = (children: { href: string }[] = []) => children.some((c) => c.href !== '/' && path.startsWith(c.href));
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Friends of Nigeria — home">
      <Image src={logo} alt="Friends of Nigeria" width={82} height={51} densities={[1, 2]} loading="eager" fetchpriority="high" class="brand-logo" />
    </a>

    <nav class="primary-nav" aria-label="Main">
      <ul class="nav-list" role="list">
        {
          mainNav.map((item, i) => (
            <li class:list={['nav-item', { 'has-menu': item.children }]} data-nav-item>
              <a
                href={item.href}
                class="nav-link"
                aria-current={isActive(item.href) || activeIn(item.children) ? 'page' : undefined}
              >
                {item.label}
              </a>
              {item.children && (
                <>
                  <button
                    class="nav-caret"
                    type="button"
                    aria-expanded="false"
                    aria-controls={`menu-${i}`}
                    aria-label={`Show ${item.label} menu`}
                    data-nav-toggle
                  >
                    <Icon name="chevron-down" size={14} />
                  </button>
                  <div class="nav-menu" id={`menu-${i}`} data-wide={item.children.length > 3 ? '' : undefined}>
                    <ul role="list">
                      {item.children.map((child) => (
                        <li>
                          <a href={child.href} class="menu-link">
                            {child.icon && (
                              <span class="menu-icon">
                                <Icon name={child.icon} size={18} />
                              </span>
                            )}
                            <span>
                              <span class="menu-title">{child.label}</span>
                              {child.description && <span class="menu-desc">{child.description}</span>}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a href="/membership/" class="btn btn--sm header-cta">Become a Member</a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
        <span class="visually-hidden" data-menu-label>Open menu</span>
        <span class="menu-icon-open"><Icon name="menu" size={22} /></span>
        <span class="menu-icon-close"><Icon name="close" size={22} /></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav class="container mobile-nav" aria-label="Mobile">
      <ul role="list">
        {
          mainNav.map((item, i) =>
            item.children ? (
              <li class="m-group">
                <button type="button" class="m-toggle" aria-expanded="false" aria-controls={`m-sub-${i}`} data-m-toggle>
                  <span>{item.label}</span>
                  <Icon name="chevron-down" size={18} />
                </button>
                <ul id={`m-sub-${i}`} class="m-sub" role="list" hidden>
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href}>{child.label}</a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} class="m-link" aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
        <li class="m-group">
          <button type="button" class="m-toggle" aria-expanded="false" aria-controls="m-sub-membership" data-m-toggle>
            <span>Membership</span>
            <Icon name="chevron-down" size={18} />
          </button>
          <ul id="m-sub-membership" class="m-sub" role="list" hidden>
            {
              membershipNav.map((child) => (
                <li>
                  <a href={child.href}>{child.label}</a>
                </li>
              ))
            }
          </ul>
        </li>
      </ul>
      <div class="m-footer">
        <a href="/membership/" class="btn btn--block">Become a Member</a>
        <div class="m-contact">
          <a href={`mailto:${site.contact.email}`}><Icon name="mail" size={16} />{site.contact.email}</a>
          <a href={`tel:${site.contact.phones[0].tel}`}><Icon name="phone" size={16} />{site.contact.phones[0].display}</a>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.72);
    backdrop-filter: saturate(180%) blur(18px);
    -webkit-backdrop-filter: saturate(180%) blur(18px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 400ms var(--ease),
      background-color 400ms var(--ease),
      box-shadow 400ms var(--ease);
    animation: header-in 900ms var(--ease-expo) both;
  }
  @keyframes header-in {
    from {
      opacity: 0;
    }
  }
  .site-header.is-scrolled {
    background: rgb(255 255 255 / 0.82);
    border-bottom-color: rgb(13 22 25 / 0.06);
    box-shadow: 0 10px 30px -22px rgb(13 22 25 / 0.4);
  }
  .header-inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--s-6);
    transition: height 500ms var(--ease-expo);
  }
  .brand-logo {
    transition: transform 500ms var(--ease-expo);
    transform-origin: left center;
  }
  @media (min-width: 1140px) {
    /* The bar condenses once the page scrolls, giving content more room. */
    .is-scrolled .header-inner {
      height: 64px;
    }
    .is-scrolled .brand-logo {
      transform: scale(0.84);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      animation: none;
    }
  }
  .brand {
    flex: none;
    display: block;
    border-radius: 2px;
  }
  .brand-logo {
    width: auto;
    height: 50px;
  }

  /* Desktop navigation */
  .primary-nav {
    display: none;
    margin-inline: auto;
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: 2px;
    list-style: none;
    padding: 0;
  }
  .nav-item {
    position: relative;
    display: flex;
    align-items: center;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 10px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--slate-700);
    text-decoration: none;
    border-radius: var(--r-pill);
    transition:
      color 200ms var(--ease),
      background-color 200ms var(--ease);
    white-space: nowrap;
  }
  .nav-item:not(.has-menu) .nav-link {
    padding: 0 14px;
  }
  .nav-item:not(.has-menu) .nav-link:hover {
    background: rgb(13 22 25 / 0.05);
  }
  .has-menu .nav-link {
    padding-right: 2px;
  }
  .nav-link:hover,
  .nav-item:focus-within > .nav-link,
  .nav-item:hover > .nav-link {
    color: var(--ink);
  }
  .nav-link[aria-current='page'] {
    color: var(--ink);
    position: relative;
  }
  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 3px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--accent);
  }
  .has-menu .nav-link[aria-current='page']::after {
    margin-left: -1px;
  }
  .nav-caret {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 32px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--slate-500);
    border-radius: var(--r-sm);
  }
  .nav-caret :global(svg) {
    transition: transform 200ms var(--ease);
  }
  .nav-item:hover .nav-caret :global(svg),
  .nav-caret[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }
  .nav-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: -12px;
    min-width: 300px;
    padding: 8px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity 180ms var(--ease),
      transform 220ms var(--ease),
      visibility 0s linear 220ms;
  }
  .nav-menu[data-wide] {
    min-width: 360px;
  }
  .nav-menu::before {
    content: '';
    position: absolute;
    inset: -12px 0 auto;
    height: 12px;
  }
  .nav-item:hover > .nav-menu,
  .nav-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 180ms var(--ease),
      transform 220ms var(--ease),
      visibility 0s;
  }
  .nav-menu ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .menu-link {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 10px 12px;
    border-radius: var(--r-sm);
    text-decoration: none;
    transition: background-color 140ms var(--ease);
  }
  .menu-link:hover,
  .menu-link:focus-visible {
    background: var(--paper);
  }
  .menu-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--r-sm);
    background: var(--green-50);
    color: var(--green-700);
  }
  .menu-title {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.3;
    padding-top: 1px;
  }
  .menu-link:not(:has(.menu-desc)) .menu-title {
    padding-top: 7px;
  }
  .menu-desc {
    display: block;
    font-size: 0.8125rem;
    color: var(--ink-3);
    line-height: 1.4;
    margin-top: 2px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-left: auto;
  }
  .header-cta {
    display: none;
  }
  .menu-button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    background: var(--white);
    color: var(--ink);
  }
  .menu-icon-close {
    display: none;
  }
  .menu-button[aria-expanded='true'] .menu-icon-open {
    display: none;
  }
  .menu-button[aria-expanded='true'] .menu-icon-close {
    display: block;
  }

  @media (min-width: 560px) {
    .header-cta {
      display: inline-flex;
    }
  }
  @media (min-width: 1140px) {
    .primary-nav {
      display: block;
    }
    .header-actions {
      margin-left: 0;
    }
    .menu-button {
      display: none;
    }
  }
  @media (min-width: 1140px) and (max-width: 1260px) {
    .header-inner {
      gap: var(--s-4);
    }
    .nav-link {
      padding: 0 7px;
      font-size: 0.875rem;
    }
  }

  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--white);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-top: 1px solid var(--line);
    animation: menu-in 260ms var(--ease);
  }
  .mobile-menu[hidden] {
    display: none;
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  .mobile-nav {
    padding-block: var(--s-4) var(--s-7);
    min-height: 100%;
    display: flex;
    flex-direction: column;
  }
  .mobile-nav > ul {
    list-style: none;
    padding: 0;
  }
  .mobile-nav > ul > li {
    border-bottom: 1px solid var(--line);
    animation: m-item-in 700ms var(--ease-expo) both;
  }
  .mobile-nav > ul > li:nth-child(2) { animation-delay: 40ms; }
  .mobile-nav > ul > li:nth-child(3) { animation-delay: 80ms; }
  .mobile-nav > ul > li:nth-child(4) { animation-delay: 120ms; }
  .mobile-nav > ul > li:nth-child(5) { animation-delay: 160ms; }
  .mobile-nav > ul > li:nth-child(6) { animation-delay: 200ms; }
  .mobile-nav > ul > li:nth-child(7) { animation-delay: 240ms; }
  .mobile-nav > ul > li:nth-child(8) { animation-delay: 280ms; }
  @keyframes m-item-in {
    from {
      opacity: 0;
      transform: translate3d(0, 16px, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mobile-nav > ul > li {
      animation: none;
    }
  }
  .m-link,
  .m-toggle {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    min-height: 58px;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    text-decoration: none;
    color: var(--ink);
    text-align: left;
  }
  .m-link[aria-current='page'] {
    color: var(--accent-ink);
  }
  .m-toggle :global(svg) {
    color: var(--slate-500);
    transition: transform 200ms var(--ease);
  }
  .m-toggle[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }
  .m-sub {
    list-style: none;
    padding: 0 0 var(--s-4);
    display: grid;
    gap: 2px;
  }
  .m-sub a {
    display: block;
    padding: 10px 0 10px 14px;
    border-left: 1px solid var(--line-strong);
    color: var(--ink-2);
    text-decoration: none;
    font-size: 1rem;
  }
  .m-sub a:hover {
    color: var(--ink);
    border-left-color: var(--accent);
  }
  .m-footer {
    margin-top: auto;
    padding-top: var(--s-6);
    display: grid;
    gap: var(--s-5);
  }
  .m-contact {
    display: grid;
    gap: var(--s-3);
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .m-contact a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  @media (min-width: 1140px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    // Shadow once the page is scrolled.
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Desktop dropdowns: keyboard / touch toggles. Hover is handled in CSS.
    const toggles = header.querySelectorAll<HTMLButtonElement>('[data-nav-toggle]');
    const closeAll = (except?: HTMLButtonElement) => {
      toggles.forEach((t) => {
        if (t === except) return;
        t.setAttribute('aria-expanded', 'false');
        document.getElementById(t.getAttribute('aria-controls')!)?.classList.remove('is-open');
      });
    };
    toggles.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = btn.getAttribute('aria-expanded') === 'true';
        closeAll(btn);
        btn.setAttribute('aria-expanded', String(!open));
        document.getElementById(btn.getAttribute('aria-controls')!)?.classList.toggle('is-open', !open);
      });
    });
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('[data-nav-item]')) closeAll();
    });
    header.querySelectorAll<HTMLElement>('[data-nav-item]').forEach((item) => {
      item.addEventListener('focusout', (e) => {
        if (!item.contains(e.relatedTarget as Node)) {
          const t = item.querySelector<HTMLButtonElement>('[data-nav-toggle]');
          if (t) {
            t.setAttribute('aria-expanded', 'false');
            document.getElementById(t.getAttribute('aria-controls')!)?.classList.remove('is-open');
          }
        }
      });
    });

    // Mobile menu
    const menuBtn = header.querySelector<HTMLButtonElement>('[data-menu-button]');
    const menu = header.querySelector<HTMLElement>('[data-mobile-menu]');
    const label = header.querySelector<HTMLElement>('[data-menu-label]');
    const setMenu = (open: boolean) => {
      if (!menuBtn || !menu) return;
      menuBtn.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';
    };
    menuBtn?.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
    header.querySelectorAll<HTMLButtonElement>('[data-m-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        const sub = document.getElementById(btn.getAttribute('aria-controls')!);
        if (sub) sub.hidden = open;
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      closeAll();
      if (menuBtn?.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
        menuBtn.focus();
      }
    });
    window.matchMedia('(min-width: 1140px)').addEventListener('change', (e) => {
      if (e.matches) setMenu(false);
    });
  }
</script>
