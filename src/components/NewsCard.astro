---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/format';

interface Props {
  post: CollectionEntry<'news'>;
  variant?: 'default' | 'feature' | 'compact';
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}
const { post, variant = 'default', headingLevel = 'h3', eager = false } = Astro.props;
const d = post.data;
const href = `/news/${post.id}/`;
const H = headingLevel;
---

<article class:list={['news-card', `news-card--${variant}`]}>
  {
    d.image && (
      <div class="media media--zoom news-media">
        <Image
          src={d.image}
          alt={d.imageAlt ?? ''}
          widths={variant === 'feature' ? [640, 960, 1280] : [320, 480, 720]}
          sizes={variant === 'feature' ? '(min-width: 1000px) 720px, 100vw' : variant === 'compact' ? '160px' : '(min-width: 1000px) 400px, 100vw'}
          loading={eager ? 'eager' : 'lazy'}
        />
      </div>
    )
  }
  <div class="news-body">
    <p class="meta">
      <span class="news-cat">{d.category}</span>
      <span class="dot" aria-hidden="true"></span>
      <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
    </p>
    <H class="news-title"><a href={href} class="stretched">{d.title}</a></H>
    {variant !== 'compact' && <p class="news-excerpt">{d.excerpt}</p>}
  </div>
</article>

<style>
  .news-card {
    position: relative;
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }
  .news-media {
    aspect-ratio: 3 / 2;
  }
  .news-card--feature .news-media {
    aspect-ratio: 16 / 10;
  }
  .news-body {
    display: grid;
    gap: var(--s-2);
  }
  .news-cat {
    color: var(--accent-ink);
    font-weight: 600;
  }
  .news-title {
    font-size: 1.1875rem;
    line-height: 1.3;
    letter-spacing: -0.018em;
  }
  .news-card--feature .news-title {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    line-height: 1.15;
  }
  .news-title a {
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size 400ms var(--ease);
  }
  .news-card:hover .news-title a {
    background-size: 100% 1px;
  }
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .news-excerpt {
    font-size: var(--fs-sm);
    color: var(--ink-2);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .news-card--feature .news-excerpt {
    font-size: 1rem;
    -webkit-line-clamp: 3;
  }
  .news-card--compact {
    grid-template-columns: 112px minmax(0, 1fr);
    gap: var(--s-4);
    align-items: start;
  }
  .news-card--compact .news-media {
    aspect-ratio: 1;
  }
  .news-card--compact .news-title {
    font-size: 1.0625rem;
  }
  @media (min-width: 640px) {
    .news-card--compact {
      grid-template-columns: 148px minmax(0, 1fr);
    }
    .news-card--compact .news-media {
      aspect-ratio: 4 / 3;
    }
  }
</style>
