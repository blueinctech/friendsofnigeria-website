---
import Icon from './Icon.astro';
import NewsletterForm from './forms/NewsletterForm.astro';
import { getSite, img, telHref } from '../lib/server/public';

const { site, nav, media } = await getSite(Astro.locals);
const year = new Date().getFullYear();
const logo = media[site.footer_logo] ?? media[site.logo];
const logoH = logo?.width && logo?.height ? Math.round((110 * logo.height) / logo.width) : 80;
const logoAttrs = logo ? { ...img(logo, { alt: site.short_name ? `${site.name} ${site.short_name.replace(/^FON\s*/, '')}`.trim() : site.name, sizes: '110px', maxWidth: 220 }), width: 110, height: logoH } : null;
const columns = nav.footer.filter((c) => c.children.length);
---

<footer class="site-footer grain">
  <span class="footer-glow" aria-hidden="true"></span>
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" aria-label={`${site.name} — home`} class="footer-logo">
          {logoAttrs ? <img {...logoAttrs} /> : <span>{site.name}</span>}
        </a>
        <p class="footer-desc">{site.description}</p>
        <ul class="social" role="list">
          {
            (site.social ?? []).map((s: { name: string; url: string }) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`${site.name} on ${s.name} (opens in a new tab)`}>
                  <Icon name={s.name} size={16} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        site.newsletter_enabled !== false && (
          <div class="footer-news">
            <h2 class="footer-heading-lg">{site.footer_newsletter_heading}</h2>
            <p>{site.footer_newsletter_text}</p>
            <NewsletterForm id="footer-newsletter" />
          </div>
        )
      }
    </div>

    <div class="footer-grid">
      {
        columns.map((col) => (
          <nav aria-label={col.label}>
            <h2 class="footer-heading">{col.label}</h2>
            <ul role="list">
              {col.children.map((l) => (
                <li>
                  <a href={l.url} target={l.new_tab ? '_blank' : undefined} rel={l.new_tab ? 'noopener' : undefined}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
      <div>
        <h2 class="footer-heading">Contact</h2>
        <address>
          <p class="contact-line">
            <Icon name="map-pin" size={16} />
            <span>{site.address}<br />{[site.postcode, site.city].filter(Boolean).join(' ')}{site.country ? `, ${site.country}` : ''}</span>
          </p>
          {
            (site.phones ?? []).map((p: { label: string; display: string }) => (
              <p class="contact-line">
                <Icon name="phone" size={16} />
                <a href={telHref(p.display)}>{p.display}</a>
              </p>
            ))
          }
          {site.email && (
            <p class="contact-line">
              <Icon name="mail" size={16} />
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          )}
        </address>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {site.copyright}</p>
      {site.credit_label && <p>Website by {site.credit_url ? <a href={site.credit_url} target="_blank" rel="noopener">{site.credit_label}</a> : site.credit_label}</p>}
    </div>
  </div>
  <div class="footer-mark" aria-hidden="true">
    <span>{site.name}</span>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--slate-950);
    color: var(--slate-400);
    font-size: var(--fs-sm);
    padding-top: clamp(4rem, 3rem + 4vw, 6rem);
  }
  .footer-glow {
    position: absolute;
    left: 50%;
    bottom: -30%;
    width: min(1100px, 120vw);
    aspect-ratio: 2 / 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(11 148 68 / 0.22), transparent);
    pointer-events: none;
    z-index: -1;
  }
  /* Oversized wordmark that sits on the bottom edge of the page. */
  .footer-mark {
    overflow: hidden;
    padding-inline: var(--gutter);
    margin-top: calc(var(--s-4) * -1);
    line-height: 0.8;
    user-select: none;
  }
  .footer-mark span {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(3rem, 12.6vw, 13.5rem);
    letter-spacing: -0.06em;
    white-space: nowrap;
    text-align: center;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.16), rgb(255 255 255 / 0.02) 85%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transform: translateY(18%);
  }
  /* On phones the cropped wordmark reads as a rendering glitch: leave it out. */
  @media (max-width: 639px) {
    .footer-mark {
      display: none;
    }
  }
  .footer-top {
    display: grid;
    gap: var(--s-7);
    padding-bottom: var(--s-8);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  @media (min-width: 960px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-9);
    }
  }
  .footer-logo {
    display: inline-block;
  }
  .footer-logo img {
    width: 110px;
    height: auto;
  }
  .footer-desc {
    margin-top: var(--s-5);
    max-width: 46ch;
    line-height: 1.7;
  }
  .social {
    display: flex;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin-top: var(--s-5);
  }
  .social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--r-pill);
    border: 1px solid rgb(255 255 255 / 0.12);
    color: var(--grey-200);
    transition:
      color 160ms var(--ease),
      border-color 160ms var(--ease),
      background-color 160ms var(--ease);
  }
  .social a:hover {
    color: var(--white);
    background: var(--green-600);
    border-color: var(--green-600);
  }
  .footer-heading-lg {
    font-size: var(--fs-h3);
    color: var(--white);
  }
  .footer-news > p {
    margin: var(--s-3) 0 var(--s-5);
    max-width: 44ch;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-7) var(--s-5);
    padding-block: var(--s-8);
  }
  @media (min-width: 820px) {
    .footer-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.4fr);
    }
  }
  .footer-grid > div:last-child {
    grid-column: 1 / -1;
  }
  @media (min-width: 820px) {
    .footer-grid > div:last-child {
      grid-column: auto;
    }
  }
  .footer-heading {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--grey-200);
    margin-bottom: var(--s-4);
  }
  .footer-grid ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .footer-grid a {
    text-decoration: none;
    transition: color 160ms var(--ease);
  }
  .footer-grid a:hover {
    color: var(--white);
  }
  address {
    font-style: normal;
    display: grid;
    gap: 12px;
  }
  .contact-line {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .contact-line :global(svg) {
    flex: none;
    margin-top: 4px;
    color: var(--green-500);
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3);
    padding-block: var(--s-5) var(--s-6);
    border-top: 1px solid rgb(255 255 255 / 0.08);
    font-size: var(--fs-xs);
  }
  .footer-bottom a {
    color: var(--grey-200);
    text-decoration: none;
  }
  .footer-bottom a:hover {
    color: var(--white);
  }
</style>
