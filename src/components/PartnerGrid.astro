---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
const partners = (await getCollection('partners')).sort((a, b) => a.data.order - b.data.order);
---

<ul class="partners" role="list">
  {
    partners.map((p, i) => {
      const img = <Image src={p.data.logo} alt={p.data.name} width={260} densities={[1, 2]} loading="lazy" />;
      return (
        <li data-reveal style={`--reveal-delay:${(i % 7) * 40}`}>
          {p.data.url ? (
            <a href={p.data.url} target="_blank" rel="noopener noreferrer" title={p.data.name}>
              {img}
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          ) : (
            <div title={p.data.name}>{img}</div>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .partners {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .partners {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .partners {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }
  }
  .partners li {
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--white);
  }
  .partners a,
  .partners div {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    padding: 18px 20px;
    transition: background-color 200ms var(--ease);
  }
  .partners a:hover {
    background: var(--paper);
  }
  .partners img {
    max-width: 100%;
    max-height: 72px;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: transform 300ms var(--ease);
  }
  .partners li:hover img {
    transform: scale(1.04);
  }
</style>
