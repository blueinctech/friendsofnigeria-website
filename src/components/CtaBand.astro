---
import Icon from './Icon.astro';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Be part of a network creating opportunities between Nigeria and Europe.',
  text = 'Join Nigerian professionals and European companies building partnerships, sharing expertise and opening doors on both continents.',
} = Astro.props;
---

<section class="cta-wrap">
  <div class="container">
    <div class="cta glow grain spotlight">
      <span class="glow-orb" aria-hidden="true"></span>
      <svg class="cta-orbit" viewBox="0 0 400 400" aria-hidden="true">
        <circle cx="200" cy="200" r="160" fill="none" stroke="currentColor" stroke-width="1.2" stroke-dasharray="70 14" />
        <circle cx="200" cy="40" r="7" fill="currentColor" />
        <circle cx="360" cy="200" r="7" fill="currentColor" />
        <circle cx="200" cy="360" r="7" fill="currentColor" />
        <circle cx="40" cy="200" r="7" fill="currentColor" />
      </svg>
      <div class="cta-inner">
        <div class="cta-copy">
          <h2 data-reveal>{title}</h2>
          <p data-reveal style="--reveal-delay:120">{text}</p>
        </div>
        <div class="btn-row cta-actions" data-reveal style="--reveal-delay:200">
          <a href="/membership/" class="btn btn--light">Become a Member <Icon name="arrow-right" size={16} class="arrow" /></a>
          <a href="/contact/" class="btn btn--ghost-light">Contact us</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-wrap {
    padding-block: clamp(2rem, 1rem + 3vw, 4rem) clamp(4rem, 3rem + 4vw, 7rem);
  }
  .cta {
    --spot-a: 0.22;
    border-radius: clamp(20px, 1rem + 1vw, 32px);
    background:
      radial-gradient(900px 500px at 0% 100%, rgb(32 169 87 / 0.35), transparent 60%),
      linear-gradient(135deg, var(--green-800), var(--green-900) 60%, #042a14);
    color: var(--green-100);
    box-shadow: 0 50px 100px -50px rgb(5 61 29 / 0.7);
  }
  .cta > .glow-orb {
    right: -10%;
    top: -40%;
  }
  .cta-inner {
    position: relative;
    display: grid;
    gap: var(--s-6);
    padding: clamp(3rem, 2rem + 5vw, 6.5rem) clamp(1.5rem, 0.5rem + 4vw, 5rem);
  }
  .cta h2 {
    color: var(--white);
    max-width: 18ch;
    font-size: clamp(2rem, 1.3rem + 2.8vw, 3.5rem);
  }
  .cta p {
    margin-top: var(--s-4);
    max-width: 52ch;
    font-size: var(--fs-lg);
    color: rgb(255 255 255 / 0.78);
  }
  .cta-orbit {
    position: absolute;
    right: -120px;
    top: 50%;
    width: 520px;
    height: 520px;
    transform: translateY(-50%);
    color: rgb(255 255 255 / 0.1);
    pointer-events: none;
    z-index: 0;
    animation: orbit 90s linear infinite;
  }
  @keyframes orbit {
    to {
      transform: translateY(-50%) rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-orbit {
      animation: none;
    }
  }
  @media (min-width: 960px) {
    .cta-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      column-gap: var(--s-9);
    }
    .cta-orbit {
      right: 2%;
    }
  }
</style>
