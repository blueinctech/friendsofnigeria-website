---
import Icon from './Icon.astro';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Be part of a network creating opportunities between Nigeria and Europe.',
  text = 'Join Nigerian professionals and European companies building partnerships, sharing expertise and opening doors on both continents.',
} = Astro.props;
---

<section class="cta">
  <div class="container cta-inner">
    <svg class="cta-orbit" viewBox="0 0 400 400" aria-hidden="true">
      <circle cx="200" cy="200" r="160" fill="none" stroke="currentColor" stroke-width="1.2" stroke-dasharray="70 14" />
      <circle cx="200" cy="40" r="7" fill="currentColor" />
      <circle cx="360" cy="200" r="7" fill="currentColor" />
      <circle cx="200" cy="360" r="7" fill="currentColor" />
      <circle cx="40" cy="200" r="7" fill="currentColor" />
    </svg>
    <div class="cta-copy" data-reveal>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row cta-actions" data-reveal style="--reveal-delay:120">
      <a href="/membership/" class="btn btn--light">Become a Member <Icon name="arrow-right" size={16} class="arrow" /></a>
      <a href="/contact/" class="btn btn--ghost-light">Contact us</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--green-800);
    color: var(--green-100);
    overflow: hidden;
  }
  .cta-inner {
    position: relative;
    display: grid;
    gap: var(--s-6);
    padding-block: clamp(4rem, 3rem + 5vw, 7rem);
  }
  .cta h2 {
    color: var(--white);
    max-width: 20ch;
  }
  .cta p {
    margin-top: var(--s-4);
    max-width: 52ch;
    font-size: var(--fs-lg);
    color: rgb(255 255 255 / 0.78);
  }
  .cta-orbit {
    position: absolute;
    right: -120px;
    top: 50%;
    width: 520px;
    height: 520px;
    transform: translateY(-50%);
    color: rgb(255 255 255 / 0.12);
    pointer-events: none;
    animation: orbit 90s linear infinite;
  }
  @keyframes orbit {
    to {
      transform: translateY(-50%) rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-orbit {
      animation: none;
    }
  }
  .cta-copy,
  .cta-actions {
    position: relative;
  }
  @media (min-width: 960px) {
    .cta-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      column-gap: var(--s-9);
    }
    .cta-orbit {
      right: 4%;
    }
  }
</style>
