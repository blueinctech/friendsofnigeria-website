{
  "name": "friendsofnigeria-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npm run db:migrate && npm run db:seed -- --if-empty && astro build",
    "build:site": "astro build",
    "build:node": "CMS_ADAPTER=node astro build",
    "preview": "node dist/server/entry.mjs",
    "check": "astro check",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/db-migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/db-seed.ts",
    "db:copy": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/db-copy.ts",
    "import:wp-entries": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/import-wp-entries.ts",
    "admin:create": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/admin-create.ts",
    "admin:reset-password": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/admin-reset-password.ts",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.6",
    "@astrojs/vercel": "^11.0.22",
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/client-sesv2": "^3.1176.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@vercel/blob": "2.4.0",
    "astro": "^7.4.7",
    "gray-matter": "^4.0.3",
    "marked": "^18.2.0",
    "pg": "^8.23.1",
    "preact": "^11.2.0",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/node": "^11.1.13",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
